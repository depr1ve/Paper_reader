# ============================================================
# Paper Reader - RAG 论文问答系统 配置文件
# 复制此文件为 .env 并填入实际值:  cp .env.example .env
# ============================================================

# --- DeepSeek API (必填) ---
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- HuggingFace 镜像 (国内加速) ---
# 设置后通过镜像下载模型，无需科学上网
HF_ENDPOINT=https://hf-mirror.com

# --- Embedding 模型 (本地运行) ---
# 模型标识，自动从 models/ 目录发现；未找到则在线下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# --- 论文存放目录 ---
DATA_DIR=./data

# --- 向量库持久化目录 (Chroma 本地模式) ---
VECTOR_STORE_DIR=./store

# --- Chroma 集合名称 ---
CHROMA_COLLECTION=papers

# --- 向量库后端 ---
# "chroma" = 本地 Chroma（默认，适合本地使用）
# "supabase" = Supabase pgvector 云端（Streamlit Cloud 部署必须选此）
VECTOR_BACKEND=chroma

# --- Supabase 云向量库 (仅 VECTOR_BACKEND=supabase 时需要) ---
# 在 https://supabase.com 创建项目后获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_your-service-role-key
SUPABASE_TABLE=papers
SUPABASE_QUERY_NAME=match_papers
SUPABASE_HYBRID_QUERY_NAME=hybrid_match_papers
# SUPABASE_PROXY=http://127.0.0.1:7890    # 国内访问 Supabase 需代理

# --- Reranker 模型 (可选) ---
# 默认自动从 models/ 目录发现 BAAI/bge-reranker-base
# 若自定义路径可手动指定:
# RERANKER_MODEL_PATH=
